{
  "workbench.colorTheme": "Cyberpunk+",
  "editor.tabSize": 2,
  "javascript.preferences.quoteStyle": "single",
  "typescript.preferences.quoteStyle": "single",
  "editor.formatOnSave": false,
  "remote.forwardOnOpen": false,
  "chat.tools.terminal.autoApprove": {
    "command": true,
    "./node_modules/.bin/ng": true,
    "/^node --version; which chromium \\|\\| which chromium-browser \\|\\| which google-chrome \\|\\| true; ls \\.vscode$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^git --no-pager diff --stat; node --check main\\.js; \\./node_modules/\\.bin/tsc --noEmit -p tsconfig\\.spec\\.json$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "./node_modules/.bin/tsc": true
  }
}