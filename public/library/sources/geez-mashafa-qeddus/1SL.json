    [
      {
        "verse": {
          "start": "1",
          "end": "1",
          "index": 0
        },
        "text": "ብፁዕ ፡ ብእሲ ፡ ዘኢሖረ ፡ በምክረ ፡ ረሲዓን ፤\n\nወዘኢቆመ ፡ ውስተ ፡ ፍኖተ ፡ ኃጥኣን ፤\n\nወዘኢነበረ ፡ ውስተ ፡ መንበረ ፡ መስተሳልቃን ።"
      },
      {
        "verse": {
          "start": "2",
          "end": "2",
          "index": 1
        },
        "text": "ዘዳእሙ ፡ ሕገ ፡ እግዚአብሔር ፡ ሥምረቱ ፤\n\nወዘሕጎ ፡ ያነብብ ፡ መዕልተ ፡ ወሌሊተ ።"
      },
      {
        "verse": {
          "start": "3",
          "end": "3",
          "index": 2
        },
        "text": "ወይከውን ፡ ከመ ፡ ዕፅ ፡ እንተ ፡ ትክልት ፡ ኀበ ፡ ሙሓዘ ፡ ማይ ፤\n\nእንተ ፡ ትሁብ ፡ ፍሬሃ ፡ በበጊዜሃ ።\n\nወቈጽላኒ ፡ ኢይትነገፍ ፤\n\nወኵሎ ፡ ዘገብረ ፡ ይፌጽም ።"
      },
      {
        "verse": {
          "start": "4",
          "end": "4",
          "index": 3
        },
        "text": "አኮ ፡ ከመዝ ፡ ኃጥኣንሰ ፡ አኮ ፡ ከመዝ ፤\n\nዳእሙ ፡ ከመ ፡ መሬት ፡ ዘይግሕፍ ፡ ነፍስ ፡ እምገጸ ፡ ምድር ።"
      },
      {
        "verse": {
          "start": "5",
          "end": "5",
          "index": 4
        },
        "text": "ወበእንተዝ ፡ ኢይትነሥኡ ፡ ረሲዓን ፡ እምደይን ፤\n\nወኢኃጥኣን ፡ ውስተ ፡ ምክረ ፡ ጻድቃን ።"
      },
      {
        "verse": {
          "start": "6",
          "end": "6",
          "index": 5
        },
        "text": "እስመ ፡ ያአምር ፡ እግዚአብሔር ፡ ፍኖቶሙ ፡ ለጻድቃን ፤\n\nወፍኖቶሙ ፡ ለኃጥኣን ፡ ትጠፍእ ።"
      }
    ],
    [
      {
        "verse": {
          "start": "1",
          "end": "1",
          "index": 0
        },
        "text": "ለምንት ፡ አንገለጉ ፡ አሕዛብ ፤\n\nወሕዘብኒ ፡ ነበቡ ፡ ከንቶ ።"
      },
      {
        "verse": {
          "start": "2",
          "end": "2",
          "index": 1
        },
        "text": "ወተንሥኡ ፡ ነገሥተ ፡ ምድር ፤\n\nወመላእክትኒ ፡ ተጋብኡ ፡ ምስሌሆሙ ፡ ኅብረ ፤\n\nላዕለ ፡ እግዚአብሔር ፡ ወላዕለ ፡ መሲሑ ።"
      },
      {
        "verse": {
          "start": "3",
          "end": "3",
          "index": 2
        },
        "text": "ንበትክ ፡ እምኔነ ፡ መኣሥሪሆሙ ፤\n\nወንገድፍ ፡ እምላዕሌነ ፡ አርዑቶሙ ።"
      },
      {
        "verse": {
          "start": "4",
          "end": "4",
          "index": 3
        },
        "text": "ዘይነብር ፡ ውስተ ፡ ሰማይ ፡ ይሥሕቆሙ ፤\n\nወእግዚአብሔር ፡ ይሳለቅ ፡ ላዕሌሆሙ ።"
      },
      {
        "verse": {
          "start": "5",
          "end": "5",
          "index": 4
        },
        "text": "ሶበ ፡ ይነቦሙ ፡ በመዐቱ ፤ ወበመዐቱ ፡ የሀውኮሙ ።"
      },
      {
        "verse": {
          "start": "6",
          "end": "6",
          "index": 5
        },
        "text": "ወአንሰ ፡ ተሠየምኩ ፡ ንጉሥ ፡ በላዕሌሆሙ ፤\n\nበጽዮን ፡ በደብረ ፡ መቅደሱ ።"
      },
      {
        "verse": {
          "start": "7",
          "end": "7",
          "index": 6
        },
        "text": "ከመ ፡ እንግር ፡ ትእዛዞ ፡ ለእግዚአብሔር ፡ \n\nእግዚአብሔር ፡ ይቤለኒ ፡ ወልዱየ ፡ እንተ ፤\n\nወአነ ፡ ዮም ፡ ወለድኩከ ።"
      },
      {
        "verse": {
          "start": "8",
          "end": "8",
          "index": 7
        },
        "text": "ሰአል ፡ እምነየ ፡ ወእሁብከ ፡ አሕዛበ ፡ ለርስትከ ፤\n\nወምኵናኒከኒ ፡ እስከ ፡ አጽናፈ ፡ ምድር ።"
      },
      {
        "verse": {
          "start": "9",
          "end": "9",
          "index": 8
        },
        "text": "ወትሬዕዮሙ ፡ በበትረ ፡ ኀጺን ፤\n\nወከመ ፡ ንዋየ ፡ ለብሓ ፡ ትቀጠቅጦሙ ።"
      },
