`[[{"verse":{"start":"1","end":"1","index":0},"text":"ቃል ብመጀመርታ ነበረ፡ እቲ ቓል ድማ ኣብ ኣምላኽ ነበረ፡ እቲ ቓልውን ኣምላኽ ነበረ።"},{"verse":{"start":"2","end":"2","index":1},"text":"እዚ ብመጀመርታ ኣብ ኣምላኽ ነበረ።"},{"verse":{"start":"3","end":"3","index":2},"text":"ብእኡ ዅሉ ዀነ፡ ካብቲ ዝዀነ ዘበለ ድማ ብዘይ ብእኡ ዝዀነ የልቦን።"},{"verse":{"start":"4","end":"4","index":3},"text":"ህይወት ኣብኡ ነበረት፡ እታ ህይወት ከኣ ብርሃን ሰብ ነበረት።"},{"verse":{"start":"5","end":"5","index":4},"text":"ብርሃንውን ኣብ ጸልማት የብርህ፡ ጸልማት ግና ኣይሓዞን።"},{"verse":{"start":"6","end":"6","index":5},"text":"ዮሃንስ ዝስሙ ሰብኣይ ካብ ኣምላኽ ተልኢኹ ተንስኤ።"},{"verse":{"start":"7","end":"7","index":6},"text":"ኵሎም ብእኡ ናብ እምነት ምእንቲ ኺበጽሑ፡ ብዛዕባ ብርሃን ኪምስክር ንሱ ንምስክር መጸ።"},{"verse":{"start":"8","end":"8","index":7},"text":"ብዛዕባ ብርሃን ደኣ ኺምስክር መጸ እምበር፡ ንሱስ ብርሃን ኣይነበረን።"},{"verse":{"start":"9","end":"9","index":8},"text":"እቲ ንነፍሲ ወከፍ ሰብ ዜብርህ ብርሃን ሓቂ ናብ ዓለም ይመጽእ ነበረ።"},{"verse":{"start":"10","end":"10","index":9},"text":"ኣብ ዓለም ነበረ፡ ዓለምውን ብእኡ ዀነት፡ ዓለም ግና ኣይፈለጠቶን።"},{"verse":{"start":"11","end":"11","index":10},"text":"ናብቶም ናቱ መጸ፡ እቶም ናቱ ኸኣ ኣይተቐበልዎን።"},{"verse":{"start":"12","end":"12","index":11},"text":"ነቶም እተቐበልዎ ዘበሉ ዅሎም ብስሙ ንዚኣምኑ ግና ውሉድ ኣምላኽ ኪዀኑ መሰል ሃቦም።"},{"verse":{"start":"13","end":"13","index":12},"text":"ንሳቶም ከኣ ካብ ኣምላኽ እምበር፡ ካብ ደም፡ ወይ ካብ ፍቓድ ስጋ፡ ወይ ካብ ፍቓድ ሰብኣይ ዘይተወልዱ እዮም።"},{"verse":{"start":"14","end":"14","index":13},"text":"እቲ ቓል ስጋ ዀነ፡ ጸጋን ሓቅን መሊእዎ ኸኣ ኣባና ሐደረ። ክብረቱ ድማ ከም ክብሪ ናይቲ ሓደ ወዲ ነቦኡ ርኤና።"},{"verse":{"start":"15","end":"15","index":14},"text":"ዮሃንስ ብዛዕባኡ መስከረ፡ እቲ ድሕረይ ዚመጽእ፡ ንሱ ቕድመይ ዝነበረ እዩ እሞ፡ ንሱ ቕድመይ ነበረ፡ እቲ ብዛዕባኡ ዝበልኩ ንሱ እዩ፡ ኢሉ ጨደረ።"},{"verse":{"start":"16","end":"17","index":15},"text":"ሕጊ ብሙሴ ተውሂቡ እዩ እሞ፡ ጸጋን ሓቅን ግና ብየሱስ ክርስቶስ መጸ። እምብኣርከ ንሕና ዅላትና ኻብ ምልኣቱ ጸጋ ኣብ ልዕሊ ጸጋ ተቐበልና፡"},{"verse":{"start":"18","end":"18","index":16},"text":"ሓደ እኳ ንኣምላኽ ዝረኣዮ የልቦን፡ እቲ ኣብ ሕቝፊ ኣቦኡ ዘሎ ሓደ ወዲ፡ ንሱ ኣግሃዶ።"},{"verse":{"start":"19","end":"19","index":17},"text":"ኣይሁድ፥ ንስኻ መን ኢኻ፧ ኢሎም ኪሐትዎ፡ ካብ የሩሳሌም ካህናትን ሌዋውያንን ምስ ለኣኹሉ፡ ምስክር ዮሃንስ እዚ እዩ፥"},{"verse":{"start":"20","end":"20","index":18},"text":"ንሱውን፥ ኣነስ ክርስቶስ ኣይኰንኩን፥ ኢሉ ተኣመነ እምበር፡ ኣይከሐደን።"},{"verse":{"start":"21","end":"22","index":19},"text":"ሽዑ ንሳቶም፡ መን ደኣ ኢኻ፧ ነቶም ዝለኣኹና ምላሽ ምእንቲ ኽንህቦምሲ፡ ብዛዕባ ርእስኻ እንታይ ትብል፡ በልዎ።"},{"verse":{"start":"23","end":"23","index":20},"text":"ንሱ ኸኣ፥ ኣነስ፡ ከምቲ ነብዪ ኢሳይያስ፥ መገዲ እግዚኣብሄር ኣቕንዑ፡ ዝበሎ፡ ኣብ በረኻ ዚእውጅ ድምጺ እየ፡ በሎም።"},{"verse":{"start":"24","end":"24","index":21},"text":"እቶም ልኡኻት ካብ ፈሪሳውያን ነበሩ።"},{"verse":{"start":"25","end":"25","index":22},"text":"ንሳቶም ከኣ፥ እምብኣርሲ ክርስቶስ፡ ወይ ኤልያስ፡ ወይ እቲ ነብዪ ኻብ ዘይኰንካስ፡ ንምንታይ ደኣ ተጥምቕ አሎኻ፡ ኢሎም ሐተትዎ።"},{"verse":{"start":"26","end":"26","index":23},"text":"ዮሃንስ ድማ፥ ኣነ ብማይ ኤጥምቕ አሎኹ፡ ግናኸ ንስኻትኩም ዘይትፈልጥዎ ኣብ ማእከልኩም ደው ኢሉ አሎ።"},{"verse":{"start":"27","end":"27","index":24},"text":"እቲ ቕድመይ ዝነበረ ድሕረይ ዚመጽእ፡ ንሱ እዩ፡ ኣነ ስራኽ ኣሳእኑ ንምፍታሕ እኳ ዘይበቕዕ እየ፡ ኡሉ መለሰ።"},{"verse":{"start":"28","end":"28","index":25},"text":"እዚ ኣብቲ ዮሃንስ የጥምቐሉ ዝነበረ፡ ኣብ ቢታንያ ኣብ ማዕዶ ዮርዳኖስ ኰነ።"},{"verse":{"start":"29","end":"29","index":26},"text":"ንጽብሒቱ ዮሃንስ ንየሱስ፡ ናብኡ ኺመጽእ ከሎ ረኣየ እሞ፥ እንሆ፡ ሓጢኣት ዓለም ዜርሕቕ ገንሸል ኣምላኽ፡ በለ።"},{"verse":{"start":"30","end":"30","index":27},"text":"እቲ ብዛዕባኡ፥ ሓደ ሰብኣይ ድሕረይ ይመጽእ፡ ንሱ ቕድመይ ነይሩ እዩ እሞ፡ ንሱ ቕድመይ ኰነ፡ ዝበልክዎ እዚ እዩ።"},{"verse":{"start":"31","end":"31","index":28},"text":"ኣነ ድማ ኣይፈለጥክዎን፡ ንሱ ንእስራኤል ምእንቲ ኺግለጽ ግና፡ ኣነ ብማይ እናኣጥመቕኩ መጻእኩ።"},{"verse":{"start":"32","end":"32","index":29},"text":"ዮሃንስ ድማ፡ መንፈስ ቅዱስ ካብ ሰማይ ከም ርግቢ ወሪዱ ኣብኡ ኪቕመጥ ከሎ ርኤኹ፡ ኢሉ መስከረ።"},{"verse":{"start":"33","end":"33","index":30},"text":"እቲ ብማይ ከጥምቕ ዝለኣኸኒ ደኣ፥ እቲ፡ መንፈስ ቅዱስ ወሪዱ ኣብኡ ኪቕመጥ ከሎ እትርእዮ፡ ንሱ እዩ ብመንፈስ ቅዱስ ዜጥምቕ፡ ኢሉኒ እምበር፡ ኣነስ ኣይፈለጥክዎን።"},{"verse":{"start":"34","end":"34","index":31},"text":"ኣነ ኸኣ ርኤኹ እሞ፡ ንሱ ወዲ ኣምላኽ ምዃኑ መስከርኩ።"},{"verse":{"start":"35","end":"35","index":32},"text":"ንጽብሒቱ ድማ ዮሃንስ ምስ ክልተ ደቀ መዛሙርቱ ኸም ብሓድሽ ደው ኢሉ ነበረ።"},{"verse":{"start":"36","end":"36","index":33},"text":"ንየሱስ ኪሐልፍ ከሎ ረኣዮ እሞ፥ እንሆ፡ ገንሸል ኣምላኽ፡ በለ።"},{"verse":{"start":"37","end":"37","index":34},"text":"እቶም ክልተ ደቀ መዛሙርቱ ኸኣ፡ እዚ ኺብል ከሎ ሰሚዖም፡ ንየሱስ ሰዓብዎ።"},{"verse":{"start":"38","end":"38","index":35},"text":"የሱስ ከኣ ግልጽ ኢሉ ኺስዕብዎ ኸለዉ