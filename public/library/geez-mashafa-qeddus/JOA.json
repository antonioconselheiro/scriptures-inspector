e":{"start":"7","end":"7","index":6},"text":"ሽዑ የሱስ ከም ብሓድሽ በሎም፥ እቲ ደገ ኣባጊዕ ኣነ ከም ዝዀንኩ፡ ብሓቂ፡ ብሓቂ እብለኩም አሎኹ።"},{"verse":{"start":"8","end":"8","index":7},"text":"እቶም ቅድመይ ዝመጹ ዅላቶም ሰረቕትን ጓሓሉትን እዮም፡ እተን ኣባጊዕ ግና ኣይሰምዓኦምን እየን።"},{"verse":{"start":"9","end":"9","index":8},"text":"እቲ ደገ ኣነ እየ። ብኣይ ዚኣቱ ኪድሕን፡ ኪኣቱን ኪወጽእን መጓሰዪውን ኪረክብ እዩ።"},{"verse":{"start":"10","end":"10","index":9},"text":"ሰራቒ፡ ብጀካ ኺሰርቕን ኪሐርድን ኬጥፍእን ኢሉ ኣይመጽእን እዩ። ኣነ ግና ህይወት ምስ ተረፉ ምእንቲ ኺረክባ እየ ዝመጻእኩ።"},{"verse":{"start":"11","end":"11","index":10},"text":"እቲ ሕያዋይ ጓሳ ኣነ እየ። እቲ ሕያዋይ ጓሳ ህይወቱ በጃ ኣባጊዑ የሕልፋ።"},{"verse":{"start":"12","end":"12","index":11},"text":"እቲ ብዓል ዓስቢ ግና፡ ጓሳ ዘይኰነስ፡ እተን ኣባጊዕውን ዘይጥሪቱ፡ ተዅላ ኺመጽእ ከሎ እንተ ረኣየ፡ ነተን ኣብጊዕ ሐዲግወን ይሃድም። እቲ ተዅላ ድማ ነተን ኣባጊዕ ይዛረፈን ፋሕውን የብለን።"},{"verse":{"start":"13","end":"13","index":12},"text":"ብዓል ዓስቢ እዩ እሞ፡ ይሃድም፡ ግዲ እተን ኣባጊዕውን የብሉን።"},{"verse":{"start":"14","end":"14","index":13},"text":"ሕያዋይ ጓሳ ኣነ እየ። ነባጊዔይ እፈልጠን እተን ኣባጊዔይውን ይፈልጣኒ እየን።"},{"verse":{"start":"15","end":"15","index":14},"text":"ከምቲ ኣቦ ንኣይ ዚፈልጠኒ፡ ኣነውን ነቦ እፈልጦ እየ። ንነፍሰይ ከኣ በጃ እተን ኣባጊዕ ኤሕልፋ።"},{"verse":{"start":"16","end":"16","index":15},"text":"ካብዚ መጓሰ እዚ ዘይኰና ኻልኦት ኣባጊዕውን ኣለዋኒ። ንኣታተን ድማ ከምጽኤን እየ፡ ቃለይውን ኪሰምዓ እየን። ሓደ መጓሰ ኪዀና እየን ጓሳኤንውን ሓደ።"},{"verse":{"start":"17","end":"17","index":16},"text":"ኣነ ንነፍሰይ በጃ ኸሕልፋ፡ መሊሰውን ክወስዳ እየ እሞ፡ ስለዚ ኣቦ የፍቅረኒ እዩ።"},{"verse":{"start":"18","end":"18","index":17},"text":"ባዕለይ እየ በጃ ዘሕልፋ እምበር ካባይ ዝወስዳስ የልቦን። በጃ ኸሕልፋ ስልጣን አሎኒ፡ መሊሰ ኽወስዳውን ስልጣን አሎኒ። ነዛ ትእዛዝ እዚኣ ኻብ ኣቦይ እየ እተቐበልክዋ።"},{"verse":{"start":"19","end":"19","index":18},"text":"ብዛዕባ እዚ ዘረባ እዚ ድማ ኣብ ማእከል ኣይሁድ ከም ብሓድሽ ምፍልላይ ኰነ።"},{"verse":{"start":"20","end":"20","index":19},"text":"ሽዑ ኻባታቶም ብዙሓት፥ ጋኔን ሒዝዎ ይዓብድ አሎ፡ እንታይ ኢልኩምዎ ኢኹም እተሰምዕዎ፧ በሉ።"},{"verse":{"start":"21","end":"21","index":20},"text":"ካልኦት ግና፥ እዚ ዘረባ እዚ ዘረባ ዕቡድ ኣይኰነን። ጋኔንዶ ኣዒንቲ ዕዉራት ኪኸፍት ይከአሎ እዩ፧ በሉ።"},{"verse":{"start":"22","end":"22","index":21},"text":"ኣብ የሩሳሌም በዓል ምሕዳስ ቤተ መቕደስ ኰነ፡ ክረምቲ ኸኣ ነበረ።"},{"verse":{"start":"23","end":"23","index":22},"text":"የሱስ ድማ ኣብ ቤተ መቕደስ ኣብ ገበላ ሰሎሞን ይመላለስ ነበረ።"},{"verse":{"start":"24","end":"24","index":23},"text":"ሽዑ ኣይሁድ ኣኽበብዎ እሞ፥ ክሳዕ መኣዝከ ኢኻ ላሕ እተብለና፡ ንስኻ ክርስቶስ እንተ ዄንካ፡ ኣግሂድካ ንገረና፡ በልዎ።"},{"verse":{"start":"25","end":"25","index":24},"text":"የሱስ መለሰሎም፥ ነጊረኩም ኣይኣመንኩምን። እዚ ብስም ኣቦይ ዝገብሮ ዘሎኹ ግብርታት ይምስክረለይ አሎ።"},{"verse":{"start":"26","end":"26","index":25},"text":"ንስኻትኩም ግና፡ ከምቲ ዝበልኩኹም፡ ካብተን ኣባጊዔይ ስለ ዘይኰንኩም፡ ኣይትኣምኑን ኢኹም።"},{"verse":{"start":"27","end":"27","index":26},"text":"እተን ኣባጊዔይ ግና ድምጼይ ይሰምዓ፡ ኣነ ኸኣ ኤለልየን፡ ንሳተንውን ይስዕባኒ።"},{"verse":{"start":"28","end":"28","index":27},"text":"ኣነ ኸኣ ህይወት ዘለኣለም እህበን፡ ንዘለኣለም ድማ ኣይጠፍኣን እየን፡ ካብ ኢደይውን ዚምንዝዔን የልቦን።"},{"verse":{"start":"29","end":"29","index":28},"text":"እቲ ንኣታተን ዝሃበኒ ኣቦይ ካብ ኵሉ ይዓቢ እዩ’ ካብ ኢድ ኣቦይ ሓደ እኳ ኺምንዝዔን ዚኽእል የልቦን።"},{"verse":{"start":"30","end":"30","index":29},"text":"ኣነን ኣቦን ሓደ ኢና።"},{"verse":{"start":"31","end":"31","index":30},"text":"ኣይሁድ ብዳርባ እምኒ ኪቐትልዎ ኸም ብሓድሽ እምኒ ኣልዓሉ።"},{"verse":{"start":"32","end":"32","index":31},"text":"የሱስ ከኣ፥ ካብ ኣቦይ ብዙሕ ሰናይ ግብርታት ኣርኤኹኹም። ስለ ኣያናዪ ግብሪ ኢኹም ብዳርባ እምኒ ኽትቀትሉኒ እትደልዩ ዘሎኹም፧ ኢሉ መለሰሎም።"},{"verse":{"start":"33","end":"33","index":32},"text":"ኣይሁድ ከኣ፥ ስለቲ ምጽራፍካን ሰብ ክነስኻ ንፍስኻ ኣምላኽ ስለ ምግባርካን እምበር፡ ስለቲ ጽቡቕ ግብርታትካስ ኣይኰንናን ብእምኒ እንቐትለካ፡ ኢሎም መለስሉ።"},{"verse":{"start":"34","end":"34","index":33},"text":"የሱስ መለሰሎም፥ ኣብ ሕግኹም፥ ኣነ፥ ኣማልኽቲ ኢኹም፡ በልኩ፡ ዚብልዶ ኣይተጻሕፈን እዩ፧"},{"verse":{"start":"35","end":"35","index":34},"text":"ነቶም ቃል ኣምላኽ ዝመጸሎም ኣማልኽቲ ኻብ ዚብሎም፡ -ጽሑፍ ኪፈርስ ኣይከኣልን እዩ፦"},{"verse":{"start":"36","end":"36","index":35},"text":"ነቲ ኣቦ ዝቐደሶ ናብ ዓለምውን ዝለኣኾ ግዳ፡ ወዲ ኣምላኽ እየ ስለ ዝበልኩኹም፡ ከመይ ኢልኩም፥ ትጻረፍ አሎኻ፡ ትብሉኒ አሎኹም፧"},{"verse":{"start":"37","end":"37","index":36},"text":"ግብሪ ኣቦይ እንተ ዘይገበርኩ፡ ኣይትእመኑኒ።"},{"verse":{"start":"38","end":"38","index":37},"text":"እንተ ገበርኩ ግና፡ ኣቦ ኣባይ ምህላዉ፡ ኣነውን ኣብ ኣቦ ምህላወይ ምእንቲ ኽትፈልጡን ከተስተብህሉንሲ፡ ንኣይ እኳ እንተ ዘይኣመንኩምኒ፡ ነቲ ግብረይ እመንዎ።"},{"verse":{"start":"39","end":"39","index":38},"text":"መሊሶም ድማ ኪሕዝዎ ደለዩ፡ ንሱ ግና ካብ ኣእዳዎም መለቘ።"},{"verse":{"start":"40","end":"40","index":39},"text":"ከም ብሓድሽ ናብታ ዮሃንስ ቀደም የጥምቐላ ዝነበረ ስፍራ ናብ ማዕዶ ዮርዳኖስ ከደ፡ ኣብኣውን ተቐመጠ።"},{"verse":{"start":"41","end":"41","index":40},"text":"ብዙሓት ድማ ናብኡ መጺኦም፥ ዮሃንስ ሓንቲ ተኣምራት እኳ ኣይገበረን፥ እቲ ዮሃንስ ብዛዕባኡ እተዛረቦ ዘበለ ዅሉ ግና ሓቂ ዀነ፡ በሉ።"},{"verse":{"start":"42","end":"42","index":41},"text":"ኣብኡውን ብዙሓት ብእኡ አመኑ።"}],[{"verse":{"start":"1","end":"1","index":0},"text":"ኣብ ቢታንያ፡ ኣብታ ዓዲ ማርያምን ማርታ ሓብታን፡ ኣልኣዛር ዝስሙ ሕሙም ሰብኣይ ነበረ።"},{"verse":{"start":"2","end":"2","index":1},"text":"ማርያም እታ ንጐይታ ቕዱይ ቅብኢ ዝለኸየቶ፡ ብጸጕሪ ርእሳውን ኣእጋሩ ዝደረዘቶ እያ፡ እቲ ሕሙምውን ኣልኣዛር ሓዋ እዩ።"},{"verse":{"start":"3","end":"3","index":2},"text":"ስለዚ እተን ኣሓቱ፥ ጐይታይ፡ እቲ እተፍቅሮስ እንሆ፡ ሐሚሙ አሎ፡ ኢለን ናብ የሱስ ለኣኻ።"},{"verse":{"start":"4","end":"4","index":3},"text":"የሱስ እዚ ሰሚዑ፥ እዚ ሕማም እዚ ወዲ ኣምላኽ ብእኡ ምእንቲ ኪኸብር፡ ንኽብሪ ኣምላኽ እዩ እምበር፡ ንሞት ኣይኰነን፡ በለ።"},{"verse":{"start":"5","end":"5","index":4},"text":"የሱስ ንማርታን ንሓብታን ንኣልኣዛርን የፍቕሮም ነበረ።"},{"verse":{"start":"6","end":"6","index":5},"text":"ምሕማሙ ምስ ሰምዔ፡ ኣብታ ዘለዋ ስፍራ ኽልተ መዓልቲ ወዓለ።"},{"verse":{"start":"7","end":"7","index":6},"text":"ድሕርዚ ንደቀ መዛሙርቱ፥ ደጊም ንዑናይ፡ ናብ ምድሪ ይሁዳ ንኺድ፡ በሎም።"},{"verse":{"start":"8","end":"8","index":7},"text":"ደቀ መዛሙርቱ ኸኣ፥ መምህር፡ ብኣምሆ ኣይሁድ ብዳርባ እምኒ ኪቐትሉኻ ይደልዩ ነይሮምሲ፡ መሊስካዶ ናብኡ ትከይድ፧ በልዎ።"},{"verse":{"start":"9","end":"9","index":8},"text":"የሱስ ከኣ፥ መዓልትስ ዓሰርተው ክልተ ሰዓት ደይኰነትን፧ እቲ ብመዓልቲ ዚኸይድ፡ ብርሃን እዛ ዓለም እዚኣ ዚርኢ ስለ ዝዀነ፡ ኣይዕንቀፍን።"},{"verse":{"start":"10","end":"10","index":9},"text":"እቲ ብለይቲ ዚኸይድ ግና፡ ብርሃን ስለ ዜብሉ፡ ይዕንቀፍ እዩ፡ ኢሉ መለሰ።"},{"verse":{"start":"11","end":"11","index":10},"text":"እዚ ተዛረበ፡ ድሕርዚ ድማ፥ ኣልኣዛር ፈታዊና ደቂሱ አሎ። ኣነ ግና ካብ ድቃሱ ምእንቲ ኸተንስኦ፡ ክኸይድ እየ፡ በሎም።"},{"verse":{"start":"12","end":"12","index":11},"text":"ሽዑ ደቀ መዛሙርቱ፥ ጐይታይ፡ ደቂሱ እንተ ዀይኑስ፡ ኪጥዒ እዩ፡ በልዎ።"},{"verse":{"start":"13","end":"13","index":12},"text":"የሱስ ብዛዕባ ሞቱ እዩ እተዛረበ፡ ንኣታቶም ግና ብዛዕባ ናይ ትኽስ ድቃስ እተዛረበ መሰሎም።"},{"verse":{"start":"14","end":"14","index":13},"text":"ሽዑ የሱስ ብግህዶ፥ ኣልኣዛር ሞይቱ፡"},{"verse":{"start":"15","end":"15","index":14},"text":"ኣነ ኣብኡ ብዘይ ምንባረይ፡ ምእንቲ ኽትኣምኑስ፡ ብዛዕባኹም እሕጐስ አሎኹ። ግናኸ ንዑናይ፡ ናብኡ ንኺድ፡ በሎም።"},{"verse":{"start":"16","end":"16","index":15},"text":"ስለዚ እቲ ዲዲሞስ ዚብልዎ ቶማስ ነቶም ብጾቱ ደቀ መዛሙርቲ፥ ንሕናውንከ ምስኡ ኽንመውት ንኺድ፡ በሎም።"},{"verse":{"start":"17","end":"17","index":16},"text":"ሽዑ የሱስ ምስ መጸ፡ ኣብ መቓብር ኣርባዕተ መዓልቲ ገይሩ ረኸቦ።"},{"verse":{"start":"18","end":"18","index":17},"text":"ምቕራብ ቢታንያ ንየሩሳሌም ኣስታት ዓሰርተው ሓሙሽተ እስታድዮስ ኣቢሉ እዩ።"},{"verse":{"start":"19","end":"19","index":18},"text":"ካብ ኣይሁድ ድማ ብዙሓት ብዛዕባ ሓወን ኬጸናንዕወን፡ ናብ ማርያምን ማርታን መጺኦም ነበሩ።"},{"verse":{"start":"20","end":"20","index":19},"text":"ማርታ ምምጻእ የሱስ ሰሚዓ፡ ክትቅበሎ ወጸት። ማርያም ግና ኣብ ቤት ተቐሚጣ ነበረት።"},{"verse":{"start":"21","end":"21","index":20},"text":"ሽዑ ማርታ ንየሱስ፡ ጐይታይ፡ ኣብዚ እንተ ትነብርሲ ግዲ፡ ሐወይ ኣይምሞተን ነይሩ፧"},{"verse":{"start":"22","end":"22","index":21},"text":"ግናኸ ሕጂውን ካብ ኣምላኽ ዝለመንካዮ ዘበለ ኣምላኽ ከም ዚህበካ፡ እፈልጥ አሎኹ፡ በለቶ።"},{"verse":{"start":"23","end":"23","index":22},"text":"የሱስ ድማ፡ ሓውኪ ኺትንስእ እዩ፡ በላ።"},{"verse":{"start":"24","end":"24","index":23},"text":"ማርታ ድማ፥ በታ ዳሕረይቲ መዓልቲ ብትንሳኤ ኸም ዚትንስእሲ፡ እፈልጥ አሎኹ፡ በለቶ።"},{"verse":{"start":"25","end":"25","index":24},"text":"የሱስ ከኣ፡ ትንሳኤን ህይወትን ኣነ እየ። እቲ ብኣይ ዝኣምን እንተ ሞተ እኳ፡ ብህይወት ኪነብር እዩ።"},{"verse":{"start":"26","end":"26","index":25},"text":"ነፍሲ ወከፍ ብህይወት ዘሎ እሞ ብኣይ ዚኣምን ከኣ ንዘለኣለም ኣይኪመውትን እዩ። እዚዶ ትኣምኒ ኢኺ፧ በላ።"},{"verse":{"start":"27","end":"27","index":26},"text":"ንሳ፡ እወ ጐይታይ፡ ንስኻ እቲ ናብ ዓለም ዚመጽእ ክርስቶስ ወዲ ኣምላኽ ምዃንካ ኣሚነ አሎኹ፡ በለቶ።"},{"verse":{"start":"28","end":"28","index":27},"text":"እዚ ኢላ ኸደት፡ ንማርያም ሓብታ ድማ ሰላሕ ኢላ፡ መምህር መጺኡ ይጽውዓኪውን አሎ፡ ኢላ ጸውዓታ።"},{"verse":{"start":"29","end":"29","index":28},"text":"ንሳ እዚ ምስ ሰምዔት፡ ቀልጢፋ ተንስኤት፡ ናብኡውን ከደት።"},{"verse":{"start":"30","end":"30","index":29},"text":"የሱስ ኣብታ እተቐበለቶ ስፋር ጸንሔ እምበር፡ ናብ ዓዲ ኣይኣተወን ነበረ።"},{"verse":{"start":"31","end":"31","index":30},"text":"እቶም ኬጸናንዕዋ ምስኣ ኣብ ቤት ዘለዉ ኣይሁድ ግና፡ ማርያም ቀልጢፋ ብድድ ምባላን ምውጽኣን ርእዮም፡ ናብ መቓብር ከይዳ ኣብኡ ኽትበኪ እያ፡ ኢሎም ሰዓብዋ።"},{"verse":{"start":"32","end":"32","index":31},"text":"ማርያም ናብታ የሱስ ዘለዋ ስፋራ መጺኣ ምስ ረኣየቶ፡ ኣብ እግሩ ተደፊኣ፡ ጐይታይ፡ ኣብዚ እንተ ትነብርሲ ግዲ፡ ሓወይ ኣይምሞተን ነይሩ፡ በለቶ።"},{"verse":{"start":"33","end":"33","index":32},"text":"ሽዑ የሱስ፡ ንሳ ኽትበኪ ኸላ፡ እቶም ምስኣ ዝመጹ ኣይሁድውን ኪበኽዩ ኸለዉ ርእዩ፡ ብ