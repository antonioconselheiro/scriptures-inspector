rt":"4","end":"4","index":3},"text":"የሱስ ድማ፥ ኣቲ ሰበይቲ፡ ምሳኺኸ እንታይ አሎኒ፡ ጊዜይ ገና ኣይበጽሔን፡ በላ።"},{"verse":{"start":"5","end":"5","index":4},"text":"ኣዲኡ ኸኣ ነቶም ተዓጠቕቲ፥ ንሱ ዚብለኩም ኵሉ ግበሩ፡ በለቶም።"},{"verse":{"start":"6","end":"6","index":5},"text":"ኣብኡ ኸም ስርዓት ምጽራይ ኣይሁድ ሹድሽተ ኣጋንእ እምኒ ተተኺሉ ነበረ፡ እቲ ኣጋንእ ከክልተ ወይ ሰሰለስተ ዝንግሪር ዜግብእ እዩ።"},{"verse":{"start":"7","end":"7","index":6},"text":"የሱስ፥ ነዚ ኣጋንእ ማይ ምልእዎ፡ በሎም። ኣፍ ንኣፍ ከኣ መልእዎ።"},{"verse":{"start":"8","end":"8","index":7},"text":"ሽዑ፥ ሕጂ ቅድሕዎ እሞ ነቦ ዳስ ውሰድሉ፡ በሎም። ንሳቶም ከኣ ወሰዱ።"},{"verse":{"start":"9","end":"9","index":8},"text":"እቲ ኣቦ ዳስ ግና ነቲ ንወይኒ እተለወጠ ማይ ምስ ጠዓሞ፡ ካበይ ምዃኑ ኣይፈለጠን፦ እቶም ማይ ዝመልኡ ተዓጠቕቲ ግና ይፈልጡ ነበሩ፦ እቲ ኣቦ ዳስ ነቲ መርዓዊ ጸዊዑ፥"},{"verse":{"start":"10","end":"10","index":9},"text":"ኵሉ ሰብ ቅድም ጽቡቕ ወይኒ፡ ምስ ሰኸሩ ኸኣ እቲ ሕምቕ ዝበለ ደኣ የቕርብ። ንስኻ ግና ነቲ ጽቡቕ ወይኒ ኽሳዕ ሕጂ ኣጽናሕካዮ፡ በሎ።"},{"verse":{"start":"11","end":"11","index":10},"text":"የሱስ ነዚ መጀመርያ ተኣምራቱ እዚ ኣብ ቃና ናይ ገሊላ ገበሮ። ክብረቱ ኸኣ ገለጸ፡ ደቀ መዛሙርቱውን ብእኡ አመኑ።"},{"verse":{"start":"12","end":"12","index":11},"text":"ድሕርዚ ንሱ ምስ ኣዲኡን ኣሕዋቱን ደቀ መዛሙርቱን ናብ ቅፍርናሆም ወረደ። ኣብኡውን ሒደት መዓልቲ ጸንሑ።"},{"verse":{"start":"13","end":"13","index":12},"text":"ፋስጋ ኣይሁድ ከኣ ቀሪቡ ነበረ፡ የሱስውን ናብ የሩሳሌም ደየበ።"},{"verse":{"start":"14","end":"14","index":13},"text":"ኣብ ቤተ መቕደስ ከኣ ኣብዑርን ኣባጊዕን ኣራግብን ዚሸጡን ሸረፍቲ ተቐሚጦምን ረኸበ።"},{"verse":{"start":"15","end":"15","index":14},"text":"ካብ ገመድ መግረፊ ገይሩ ኸኣ፡ ምስተን ኣባጊዕን ኣብዑርን ንዅሎም ካብ ቤት መቕደስ ኣውጽኦም፡ ንወርቂ እቶም ሸረፍቲውን ፋሕ ኣበሎ፡ ንሰደቓኦም ከኣ ደንከሎ።"},{"verse":{"start":"16","end":"16","index":15},"text":"ነቶም ሸየጥቲ ኣራግብ ድማ፥ እዚ ካብዚ ኣልዕልዎ፡ ንቤት ኣቦይ ቤት ዕዳጋ ኣይትግበርዎ፡ በሎም።"},{"verse":{"start":"17","end":"17","index":16},"text":"ደቀ መዛሙርቱ ኸኣ፥ ቅንኣት ቤትካ በልዓኒ፡ ጹሑፍ ከም ዘሎ ዘከሩ።"},{"verse":{"start":"18","end":"18","index":17},"text":"ሽዑ ኣይሁድ፥ እዚ እትገብር ካብ ኰንካስ፡ እንታይ ትእምርቱኸ ኸተርእየና ኢኻ፧ ኢሎም መለስሉ።"},{"verse":{"start":"19","end":"19","index":18},"text":"የሱስ ድማ፥ ነዛ ቤተ መቕደስ እዚኣ ኣፍርስዋ፡ ኣነ ኸኣ ብሰለስተ መዓልቲ ኸልዕላ እየ፡ ኢሉ መለሰሎም።"},{"verse":{"start":"20","end":"20","index":19},"text":"እቶም ኣይሁድ ከኣ፥ እዛ ቤተ መቕደስ እዚኣ በርብዓን ሹዱሽተን ዓመት እያ እተሃንጸት፡ ንስኻዶ ብሰለስተ መዓልቲ ኸተልዕላ ኢኻ፧ በልዎ።"},{"verse":{"start":"21","end":"21","index":20},"text":"ንሱ ግና ብዛዕባ መቕደስ ስጋኡ እዩ እተዛረበ።"},{"verse":{"start":"22","end":"22","index":21},"text":"ስለዚ ኸኣ ካብ ምውታት ምስ ተንስኤ፡ ደቀ መዛሙርቱ እዚ ኸም ዝበለ ዘከሩ፡ በቲ ጽሑፍን በቲ የሱስ ዝበሎ ቓልን ድማ ኣመኑ።"},{"verse":{"start":"23","end":"23","index":22},"text":"ነቲ፡ የሱስ ብበዓል ፋስጋ ኣብ የሩሳሌም ከሎ ዝገበሮ ተኣምራት ምስ ረኣዩ፡ ብዙሓት ሰባት ብስሙ ኣመኑ።"},{"verse":{"start":"24","end":"25","index":23},"text":"የሱስ ግና፡ ኣብ ሰብ ዘሎ ባዕሉ ይፈልጥ ስለ ዝነበረ፡ ሓደ እኳ ብናይ ሰብ ኪምስክረሉ ኣየድለዮን፡ ንዅሎም ይፈልጦም ነበረ እሞ፡ ኣይኣመኖምን።"}],[{"verse":{"start":"1","end":"1","index":0},"text":"ካብቶም ፈሪሳውያን ኒቆዲሞስ ዝስሙ ሰብኣይ፡ ሓለቓ ኣይሁድ ነበረ።"},{"verse":{"start":"2","end":"2","index":1},"text":"ንሱ ብለይቲ ናብ የሱስ መጺኡ፥ ረቢ፡ ብጀካ እቲ ኣምላኽ ምስኡ ዝዀነ ሰብ፡ ነዚ ንስኻ እትገብሮ ዘሎኻ ተኣምራት ኪገብሮ ዚኽእል የልቦን እሞ፡ ንስኻ መምህር ኴንካ ካብ ኣምላኽ ከም ዝመጻእካ፡ ንፈልጥ አሎና፡ በሎ።"},{"verse":{"start":"3","end":"3","index":2},"text":"የሱስ ድማ፥ ካብ ላዕሊ እንተዘይተወልደ፡ ንመንግስቲ ኣምላኽ ኪርእያ ዚኽእል ከም ዜልቦ፡ ብሓቂ እብለካ አሎኹ፡ ኢሉ መለሰሉ።"},{"verse":{"start":"4","end":"4","index":3},"text":"ኒቆዲሞስ ከኣ፥ ንሰብከ ምስ ኣረገ፡ ኪውለድ ከመይ ኢሉ ይከአሎ፧ መሊሱ ናብ ከርሲ ኣዲኡ ኣትዩስ ኪውለድ ይከአሎ'ዶ እዩ፧ በሎ።"},{"verse":{"start":"5","end":"5","index":4},"text":"የሱስ መለሰ፡ ብሓቂ እብለካ አሎኹ፡ ካብ ማይን መንፈስን እንተ ዘይተወልደ፡ ኣብ መንግስቲ ኣምላኽ ኪኣቱ ዚኽእል የልቦን።"},{"verse":{"start":"6","end":"6","index":5},"text":"ካብ ስጋ እተወልደ ስጋ እዩ፡ ካብ መንፈስ እተወልደ ኸኣ መንፈስ እዩ።"},{"verse":{"start":"7","end":"7","index":6},"text":"ካብ ላዕሊ ኽትውለዱ ብግዲ እዩ ስለ ዝበልኩኻ፡ ኣይትገረም።"},{"verse":{"start":"8","end":"8","index":7},"text":"ንፋስ ናብ ዝደለዮ ይነፍስ፡ ደሃዩ ኸኣ ትሰምዕ፡ ካበይ ከም ዚመጽእ ናበይውን ከም ዚኸይድ ግና ኣይትፈልጥን ኢኻ። እቲ ኻብ መንፈስ እተወልደ ዘበለ ድማ ከምኡ እዩ።"},{"verse":{"start":"9","end":"9","index":8},"text":"ኒቆዲሞስ ከኣ፥ እዚ ደኣ ኸመይ ኢሉ ኪኸውን ይከኣል፧ ኢሉ መለሰሉ።"},{"verse":{"start":"10","end":"10","index":9},"text":"የሱስ ድማ መሊሱ በሎ፥ ንስኻ መምህር እስራኤል ኢኻ፡ እዚዶ ኣይትፈልጥን፧"},{"verse":{"start":"11","end":"11","index":10},"text":"ብሓቂ፡ ብሓቂ እብለካ አሎኹ፡ እንፈልጦ ንዛረብ፡ ዝርኤናዮውን ንምስርክር አሎና፡ ነቲ ምስክርና ግና ኣይትቕበልዎን ኢኹም።"},{"verse":{"start":"12","end":"12","index":11},"text":"ናይ ምድሪ ነገር ነጊረኩም ካብ ዘይትኣምኑስ፡ ናይ ሰማይ ነገር እንተ ነገርኩኹም ግዳ፡ ከመይ ጌርኩም ክትኣምኑ፧"},{"verse":{"start":"13","end":"13","index":12},"text":"ብጀካ እቲ ኻብ ሰማይ ዝወረደ ኣብ ሰማይውን ዘሎ ወዲ ሰብ፡ ናብ ሰማይ ዝደየበ ሓደ እኳ የልቦን።"},{"verse":{"start":"14","end":"15","index":13},"text":"ብእኡ ዚኣምን ኵሉ ናይ ዘለኣለም ህይወት ምእንቲ ኺረክብ እምበር፡ ከይጠፍእሲ፡ ከምቲ ሙሴ ኣብ በረኻ ተመን ዝሰቐለ፡ ከምኡ ድማ ወዲ ሰብ ኪስቀል ይግባእ እዩ።"},{"verse":{"start":"16","end":"16","index":14},"text":"ኣምላኽ፡ በቲ ሓደ ወዱ ዝኣመነ ዅሉ ናይ ዘለኣለም ህይወት ምእንቲ ኺረክብ እምበር፡ ከይጠፍእሲ፡ ንወዱ በጃ ኽሳዕ ዚህብ፡ ክሳዕ ክንድዚ ንዓለም ኣፍቀራ።"},{"verse":{"start":"17","end":"17","index":15},"text":"ኣምላኽ ንወዱ፡ ዓለም ብእኡ ኽትድሕን እምበር፡ ንዓለም ኪፈርዳስ ኣይለኣኾን።"},{"verse":{"start":"18","end":"18","index":16},"text":"ብእኡ ንዚኣምን ኣይፍረዶን። ነቲ ዘይኣምን ግና፡ ብስም ሓደ ወዲ  ስለ ዘይኣመነ፡ ድሮ ተፈሪድዎ አሎ።"},{"verse":{"start":"19","end":"19","index":17},"text":"እቲ ፍርዲ እዚ እዩ፥ ብርሃን ናብ ዓለም መጸ፡ ሰብ ግና፡ ግብሮም ክፉእ እዩ እሞ፡ ካብ ብርሃንሲ ጸልማት ፈተዉ።"},{"verse":{"start":"20","end":"20","index":18},"text":"ክፉእ ዚገብር ዘበለ ብርሃን ይጸልእ እዪ እሞ፡ እቲ ግብሩ ምእንቲ ኸይዝለፍ፡ ናብ ብርሃን ኣይመጽእን።"},{"verse":{"start":"21","end":"21","index":19},"text":"እቲ ሓቂ ዚገብር ግና፡ ብኣምላኽ እተገብረ እዩ እሞ፡ ግብሩ ምእንቲ ኺግለጽ፡ ናብ ብርሃን እዩ ዚመጽእ።"},{"verse":{"start":"22","end":"22","index":20},"text":"ድሕርዚ የሱስ ምስ ደቀ መዛሙርቱ ናብ ምድሪ ይሁዳ ኸደ፡ ኣብኡ ኸኣ ምሳታቶም ይመላለስን የጥምቕን ነበረ።"},{"verse":{"start":"23","end":"24","index":21},"text":"ዮሃንስ ገና ናብ ቤት ማእሰርቲ ኣይኣተወን ነበረ እሞ፡ ኣብ ሄኖን ኣብ ጥቓ ሳሌም ብዙሕ ማይ ስለ ዝነበረ፡ ዮሃንስ ኣብኡ የጥምቕ ነበረ፡ ይመጹን ይጥመቑን ከኣ ነበሩ።"},{"verse":{"start":"25","end":"25","index":22},"text":"ሽዑ ኣብ መንጎ ደቀ መዛሙርቲ ዮሃንስን ሓደ ኣይሁዳውን ብዛዕባ ምጽራይ ክርክር ተንስኤ።"},{"verse":{"start":"26","end":"26","index":23},"text":"ናብ ዮሃንስ መጺኦም፥ መምህር፡ እቲ ኣብ ማዕዶ ዮርዳኖስ ምሳኻ ዝነበረ ንስኻውን ዝመስከርካሉ፡ እንሆ፡ ንሱ የጥምቕ፡ ኵሉ ኸኣ ናብኡ ይኸይድ አሎ፡ በልዎ።"},{"verse":{"start":"27","end":"27","index":24},"text":"ዮሃንስ ከኣ መሊሱ በለ፥ ሰብ ካብ ሰማይ እንተ ዘይተዋህቦስ ሓንቲ እኳ ኺወስድ ኣይክእልን እዩ።"},{"verse":{"start":"28","end":"28","index":25},"text":"ኣነ ቀቅድሚኡ ደኣ ተለኣኽኩ እምበር፡ ክርስቶስ ኣይኰንኩን ከም ዝበልኩ፡ ንስኻትኩም ባዕላትኩም ምስክረይ ኢኹም።"},{"verse":{"start":"29","end":"29","index":26},"text":"እቲ መርዓት ዘላቶ፡ ንሱ መርዓዊ እዩ። እቲ ደው ኡሉ ንእኡ ዚሰምዖ ዓርኪ መርዓዊ ግና ብድምጺ እቲ መርዓዊ ኣዝዩ ይሕጐስ። ደጊም እዚ ሓጐሰይ ተፈጸመ።"},{"verse":{"start":"30","end":"30","index":27},"text":"ንሱ ኺዓቢ፡ ኣነ ግና ክንእስ ይግባእ።"},{"verse":{"start":"31","end":"31","index":28},"text":"እቲ ኻብ ላዕሊ ዚመጽእ ዘሎ፡ ንሱ ልዕሊ ዅሉ እዩ። ካብ ምድሪ ዝዀነ ምድራዊ እዩ፡ ናይ ምድሪውን ይዛረብ። እቲ ኻብ ሰማይ ዚመጽእ ዘሎ ግና፡ ንሱ ልዕሊ ዅሉ እዩ።"},{"verse":{"start":"32","end":"32","index":29},"text":"ነታ ምስክሩ ደኣ ዚቕበላ የልቦን እምበር፡ ንሱስ ዝረኣዮን ዝሰምዖን እዩ ዚምስክር።"},{"verse":{"start":"33","end":"33","index":30},"text":"እቲ ነታ ምስክሩ እተቐበላ ግና፡ ኣምላኽ ሓቀኛ ምዃኑ ሐተመ።"},{"verse":{"start":"34","end":"34","index":31},"text":"ኣምላኽ መንፈሱ ሰፊሩ ኣይህብን እዩ እሞ፡ ኣምላኽ ዝለኣኾ፡ ንሱ ቓል ኣምላኽ እዩ ዚነግር።"},{"verse":{"start":"35","end":"35","index":32},"text":"ኣቦ ንወዱ የፍቅሮ እዩ እሞ ኵሉ ኣብ ኢዱ ሃቦ።"},{"verse":{"start":"36","end":"36","index":33},"text":"ብወዲ ዚኣምን ናይ ዘለኣለም ህይወት ኣላቶ፡ እቲ ብወዲ ዘይኣምን ግና ቍጥዓ ኣምላኽ ደኣ ኣብኡ ይነብር እምበር፡ ንህይወት ኣይኪርእያን እዩ።"}],[{"verse":{"start":"1","end":"1","index":0},"text":"ጐይታ ኸኣ፡ እቶም ፈሪሳውያንሲ የሱስ ካብ ናይ ዮሃንስ ዚበዝሑ ደቀ መዛሙርቲ ኸም ዝገበረን ዘጥመቐን ምስማዖም ምስ ፈለጠ፦"},{"verse":{"start":"2","end":"2","index":1},"text":"ግናኸ ደቀ መዛሙርቱ ደኣ እምበር፡ የሱስ ባዕሉስ ኣየጥመቐን፦"},{"verse":{"start":"3","end":"3","index":2},"text":"ምድሪ ይሁዳ ሐዲጉ ናብ ገሊላ ተመልሰ።"},{"verse":{"start":"4","end":"4","index":3},"text":"ብሰማርያ ንምሕላፍ ከኣ ናይ ግዲ ኰኖ።"},{"verse":{"start":"5","end":"5","index":4},"text":"ኣብ ጥቓ እታ ያእቆብ ንዮሴፍ ወዱ ዝሃቦ ምድሪ ዘላ ሲካር ናብ እትብሃል ከተማ ሰማርያ መጸ።"},{"verse":{"start":"6","end":"6","index":5},"text":"ኣብኡ ኸኣ ዔላ ያእቆብ አሎ። የሱስ ከኣ ብምኻድ መገዲ ደኺሙ፡ ኣብ ጥቓ እቲ ዔላ ተቐመጠ። እቲ ጊዜኡ ሳድሰይቲ ሰዓት ኣቢሉ ነበረ።"},{"verse":{"start":"7","end":"7","index":6},"text":"ካብ ሰማርያ ኸኣ ሰበይቲ ማይ ክትቀድሕ መጸት። የሱስ ድማ፥ ማይ ኰታ ኣስትይኒ፡ በላ።"},{"verse":{"start":"8","end":"8","index":7},"text":"ደቀ መዛሙርቱ ግና ዚብላዕ ኪዕድጉ ናብ ከተማ ኸይዶም ነበሩ።"},{"verse":{"start":"9","end":"9","index":8},"text":"ኣይሁድ ምስ ሳምራውያን ኣይተሓባበሩን እዮም እሞ፡ እታ ሳምራዊት ሰበይቲ፡ ንስኻ ኣይሁዳዊ ክነስኻስ፡ ካባይ ሳምራዊት ሰበይቲ ደኣ ኸመይ ኢልካ ማይ ክትሰቲ ትልምን አሎኻ፧ በለቶ።"},{"verse":{"start":"10","end":"10","index":9},"text":"የሱስ ድማ፥ ህያብ ኣምላኽን እቲ ኣስትይኒ ዚብለኪ ዘሎ መን ምዃኑን እንተ ትፈልጥስ፡ ንስኺ ግዳ ምለመንክዮ ኔርኪ፡ ንሱ ኸኣ ማይ ህይወት ምሃበኪ ነይሩ፡ ኢሉ መለሰላ።"},{"verse":{"start":"11","end":"11","index":10},"text":"እታ ሰበይቲ ድማ፥ ጐይታይ፡ መቕድሒ የብልካን፡ እዚ ዔላ ኸኣ ዓሚቝ እዩ፡ እቲ ማይ ህይወት ደኣ ኻበይ ትረኽቦ፧"},{"verse":{"start":"12","end":"12","index":11},"text":"ንስኻዶ ኻብቲ ነዚ ዔላ እዚ ዝሃበና፡ ንሱውን ምስ ደቁን ማሉን ካብኡ ዝሰተየ ኣቦና ያእቆብ፡ ትዓቢ ኢኻ፧ በለቶ።"},{"verse":{"start":"13","end":"13","index":12},"text":"የሱስ ድማ፥ ካብዚ ማይ እዚ ዚሰቲ ዘበለ መሊሱ ኺጸምእ እዩ።"},{"verse":{"start":"14","end":"14","index":13},"text":"እቲ ካብቲ ኣነ ዝህቦ ማይ ዚሰቲ ግና፡ እቲ ኣነ ዝህቦ ማይ ኣብኡ ንዘለኣለም ህይወት ዚፍልፍል ዓይኒ ማይ ኪኸውን እዩ እምበር፡ ንዘለኣለም ኣይጸምእን እዩ፡ ኢሉ መለሰላ።"},{"verse":{"start":"15","end":"15","index":14},"text":"እታ ሰበይቲ ኸኣ፥ ጐይታይ፡ ከይጸምእ እሞ ክቐድሕ ድማ ናብዚ ኸይወርድሲ፡ ካብቲ ማይ እቲ ሃበኒ፡ በለቶ።"},{"verse":{"start":"16","end":"16","index":15},"text":"የሱስ ከኣ፥ ኪዲ፡ ሰብኣይኪ ጸዊዕኪ ናብዚ ንዒ፡ በላ።"},{"verse":{"start":"17","end":"17","index":16},"text":"እታ ሰበይቲ መሊሳ፥ ሰብኣይ የብለይን፡ በለቶ። የሱስ ከኣ፡ ሰብኣይ የብለይን ብምባልክስ ቅኑዕ ተዛረብኪ።"},{"verse":{"start":"18","end":"18","index":17},"text":"ሓሙሽተ ሰብኣይ ነይሮምኺ እዮም እሞ፡ እዚ ሕጂ ምሳኺ ዘሎውን ኣይሰብኣይክን እዩ። እዝስ ሓቂ ተዛረብኪ፡ በላ።"},{"verse":{"start":"19","end":"19","index":18},"text":"እታ ሰበይቲ በለቶ፥ ጐይታይ፡ ንስኻ ነብዪ ምዃንካ እርኢ አሎኹ።"},{"verse":{"start":"20","end":"20","index":19},"text":"ኣቦታትና ኣብዚ ኸረን እዚ ሰገዱ። ንስኻትኩም ግና፡ እታ ኺስገደላ ዚግባእ ስፍራ ኣብ የሩሳሌም እያ፡ ኢኹም እትብሉ።"},{"verse":{"start":"21","end":"21","index":20},"text":"የሱስ በላ፥ ኣቲ ሰበይቲ፡ ኣብዚ ኸረን እዚ ወይ ኣብ የሩሳሌም ነቦ ዘይትሰግዱላ ጊዜ ከም እትመጽእ፡ እመንኒ።"},{"verse":{"start":"22","end":"22","index":21},"text":"ንስኻትኩም ንዘይትፈልጥዎ ኢኹም እትሰግዱ፡ ንሕና ግና፡ ምድሓን ካብ ኣይሁድ እዩ እሞ፡ ንንፈልጦ ኢና እንሰግድ።"},{"verse":{"start":"23","end":"24","index":22},"text":"ኣምላኽ መንፈስ እዩ፡ እቶም ዚሰግድሉ ድማ ብመንፈስን ብሓቅን ኪሰግዱሉ ይግባኦም። ኣቦ ኸምዚ ዝበሉ ሰገድቲ እዩ ዚደሊ እሞ፡ እቶም ናይ ሓቂ ሰገድቲ ነቦ ብመንፈስን ብሓቅን ዚሰግዱሉ ሰዓት ክትመጽእ እያ፡ ንሳ ኸኣ ሕጂ እያ።"},{"verse":{"start":"25","end":"25","index":23},"text":"እታ ሰበይቲ ድማ፡ ክርስቶስ ዚብልዎ መሲህ ከም ዚመጽእ፡ እፈልጥ አሎኹ። ንሱ ምስ መጸ ኸኣ፡ ኵሉ ኪነግረና እዩ፡ በለቶ።"},{"verse":{"start":"26","end":"26","index":24},"text":"የሱስ ከኣ፥ ኣነ ዝዛረበኪ ዘሎኹ ንሱ እየ፡ በላ።"},{"verse":{"start":"27","end":"27","index":25},"text":"ሽዑ እቶም ደቀ መዛሙርቱ መጹ፡ ምስ ሰበይቲ ብምዝርራቡውን ተገረሙ። ግናኸ ሓደ እኳ፥ እንታይ ትደሊ፡ ወይስ፥ ንምንታይ ምስኣ ትዛረብ አሎኻ፡ ዝበሎ የልቦን።"},{"verse":{"start":"28","end":"28","index":26},"text":"እታ ሰበይቲ ኸኣ ዕትሮኣ ሐዲጋ ናብ ከተማ ኣተወት፡ ነቶም ሰብውን፥"},{"verse":{"start":"29","end":"29","index":27},"text":"ዝገበርክዎ ዘበለ ዝነገረኒ ሰብኣይ ንዑ ርኣዩ። እንድዒ፡ ክርስቶስ ኰን ይኸውን፧ በለቶም።"},{"verse":{"start":"30","end":"30","index":28},"text":"ካብ ከተማ ወጺኦም ናብኡ መጹ።"},{"verse":{"start":"31","end":"31","index":29},"text":"ኣብ መንጎ እዚ እቶም ደቀ መዛሙርቱ፥ መምህር፡ ብላዕ፡ ኢሎም ለመንዎ።"},{"verse":{"start":"32","end":"32","index":30},"text":"ንሱኸኣ፥ ኣነስ ንስኻትኩም ዘይትፈልጥዎ ዝበልዖ ብልዒ አሎኒ፡ በሎም።"},{"verse":{"start":"33","end":"33","index":31},"text":"እቶም ደቀ መዛሙርቲ ንሓድሕዶም፥ ሰብ ደዀን ገለ ዚብላዕ ኣምጺኡሉ ዀይኑ፧ ተባሃሃሉ።"},{"verse":{"start":"34","end":"34","index":32},"text":"የሱስ በሎም፥ ብልዔይሲ ፍቓድ እቲ ዝለኣኸኒ ኽገብር ዕዮኡውን ክፍጽም እዩ።"},{"verse":{"start":"35","end":"35","index":33},"text":"ንስካትኩምዶ፥ ቀውዒ ኽሳዕ ዚመጽእ ኣርባዕተ ወርሒ አሎ፡ ትብሉ ኣይኰንኩምን፧ ኣዒንትኹም ቋሕ ኣብሉ እሞ ምድሪ ድሮ ንዓጺድ ከም ዝጻዕደወት ርኣዩ፡ እብለኩም ኣለኹ።"},{"verse":{"start":"36","end":"37","index":34},"text":"ሓደ ኸም ዚዘርእ፡ ሓደ ኻልእ ከኣ ከም ዚዓጽድ፡ በዚ እዚ ዘረባ እዚ ሓቂ እዩ እሞ፡   እቲ ዚዓጽድ ውዕለቱ ይቕበል፡ እቲ ዘራእን እቲ ዓጻድን ብሓንሳእ ምእንቲ ኺሕጐሱ ኸኣ፡ ንዘለኣለም ህይወት ፍረ ይእክብ።"},{"verse":{"start":"38","end":"38","index":35},"text":"ኣነ ንኣካትኩም ኣብ ዘይጸዓርኩምሉ ኽትዓጽዱ ለኣኽኩኹም። ካልኦት ጸዓሩሉ፡ ንስኻትኩም ኣብቲ ጻዕሮም ኣቶኹም።"},{"verse":{"start":"39","end":"39","index":36},"text":"ስለቲ እታ ሰበይቲ፥ ዝገበርክዎ ዘበለ ነጊሩኒ፡ ኢላ ዝመስከረቶ ቓል፡ ካብታ ኸተማ እቲኣ ብዙሓት ሳምራውያን ብእኡ ኣመኑ።"},{"verse":{"start":"40","end":"40","index":37},"text":"እቶም ሳምራውያን ናብኡ መጺኦም፡ ምሳታቶም ኪቕመጥ ለመንዎ። ኣብኡ ኸኣ ክልተ መዓልቲ ወዓለ።"},{"verse":{"start":"41","end":"41","index":38},"text":"ኣዝዮም ዚበዝሑ ድማ ስለ ቓሉ ኣመንዎ።"},{"verse":{"start":"42","end":"42","index":39},"text":"ነታ ሰበይቲውን፥ ደጊምሲ ባዕላትና ደኣ ንሱ ብሓቂ ክርስቶስ መድሓኒ ዓለም ምዃኑ ሰሚዕናን ፈሊጥናን እምበር፡ ኣይብዘረባኽን ኢና እንኣምን ዘሎና፡ ይብልዋ ነበሩ።"},{"verse":{"start":"43","end":"44","index":40},"text":"ነብዪ ኣብ ዓዱ ኸም ዘይከብር፡ የሱስ ባዕሉ መስኪሩ ነበረ እሞ፡ ድሕሪ እተን ክልተ መዓልቲ ኻብኡ ወጺኡ ናብ ገሊላ ኸደ።"},{"verse":{"start":"45","end":"45","index":41},"text":"ናብ ገሊላ ምስ መጸ፡ እቶም ሰብ ገሊላ፡ ባዕላቶም ከኣ ናብ በዓል መጺኦም ነበሩ እሞ፡ በቲ በዓል ኣብ የሩሳሌም ዝገበሮ ስለ ዝረኣዩ፡ ተቐበልዎ።"},{"verse":{"start":"46","end":"46","index":42},"text":"የሱስ ድማ ናብታ ንማይ ናብ ወይኒ ዝለወጠላ፡ ናብ ቃና ናይ ገሊላ፡ መጸ። ኣብ ቅፍርናሆም ከኣ ወዱ ዝሐመሞ ሓደ ኣገልጋል ንጉስ ነበረ።"},{"verse":{"start":"47","end":"47","index":43},"text":"ንሱ፡ የሱስ ካብ ይሁዳ ናብ ገሊላ ኸም ዝመጸ ምስ ሰምዔ፡ ናብኡ ኸደ፡ ወዱ ንሞት ቀሪቡ ነበረ እሞ፡ ወሪዱ ኼሕውየሉ ንየሱስ ለመኖ።"},{"verse":{"start":"48","end":"48","index":44},"text":"ሽዑ የሱስ፡ ትእምርትን ተኣምራትን እንተ ዘይርኤኹም፡ ኣይትኣምኑን ኢኹም፡ በሎ።"},{"verse":{"start":"49","end":"49","index":45},"text":"እቲ ኣገልጋል ንጉስ ከኣ፥ ጐይታይ፡ ወደይ ከይሞተ ውረድ፡ በሎ።"},{"verse":{"start":"50","end":"50","index":46},"text":"የሱስ ድማ፥ ኪድ፡ ወድኻ ሐውዩልካ፡ በሎ። እቲ ሰብኣይ ከኣ በታ የሱስ እተዛረባ ቓል ኣሚኑ ኸደ።"},{"verse":{"start":"51","end":"51","index":47},"text":"ኪወርድ ከሎ፡ ባሮቱ ተቐበልዎ እሞ፥ ወድኻ ሐውዩ፡ ኢሎም ኣበሰርዎ።"},{"verse":{"start":"52","end":"52","index":48},"text":"ንሱ ኸኣ እታ ዝሐወየላ ሰዓት ሐተቶም። ንሳቶም ድማ፥ ትማሊ ብሳብዐይቲ ሰዓት ዓሶኡ ሐዲጋቶ፡ በልዎ።"},{"verse":{"start":"53","end":"53","index":49},"text":"ሽዑ ኣቦኡ በታ የሱስ፥ ወድኻ ሐውዩ፡ ዝበሎ ሰዓት ምዃና ፈለጠ። ንሱ ኸኣ ምስ ኵሉ ስድራ ቤቱ ኣመነ።"},{"verse":{"start":"54","end":"54","index":50},"text":"የሱስ ካብ ይሁዳ ናብ ገሊላ ምስ መጸ ዝገበሮ ተኣምራት፡ እዚ ኻልኣዩ እዩ።"}],[{"verse":{"start":"1","end":"1","index":0},"text":"ድሕርዚ ድማ በዓል ኣይሁድ ኰነ። የሱስውን ናብ የሩሳሌም ደየበ።"},{"verse":{"start":"2","end":"2","index":1},"text":"ኣብ የሩሳሌም ኣብ ጥቓ ደገ ኣባጊዕ ከኣ፡ ብእብራይስጢ ቤት-ሄስዳ ዚብሃል፡ ሓሙሽተ ገበላ እተገብሮ ቐላይ ነበረ።"},{"verse":{"start":"3","end":"3","index":2},"text":"ኣብኡ ምንቅስቓስ እቲ ማይ ዚጽበዩ ብዙሓት ሕሙማት፡ ዕውራትን ሓንካሳትን ድኑሳትን ይድቅሱ ነበሩ።"},{"verse":{"start":"4","end":"4","index":3},"text":"እናሓንሳእ ሓደ መልኣኽ ናብታ ቐላይ ወሪዱ ነቲ ማይ የንቀሳቕሶ ነበረ እሞ፡ እቲ ቕድም ወሪዱ ኣብቲ እንተንሳቐሰ ማይ ዝኣተወ፡ ካብ ዘለዎ ሕማም ዘበለ ይሐዊ ነበረ።"},{"verse":{"start":"5","end":"5","index":4},"text":"ሰላሳን ሾሞንተን ዓመት ዝሐመመ ሰብኣይ ከኣ ኣብኣ ነበረ።"},{"verse":{"start":"6","end":"6","index":5},"text":"የሱስ ድማ ነዚ ደቂሱ ምስ ረኣዮ፡ ነዊሕ ዘመን ምሕማሙ ፈሊጡ፥ ክትሐዊዶ ትደሊ ኢኻ፡ በሎ።"},{"verse":{"start":"7","end":"7","index":6},"text":"እቲ ሕሙም ከኣ፥ ጐይታይ፡ እቲ ማይ ምስ ተንቀሳቐሰ፡ ናብቲ ቐላይ ዜውርደኒ ሰብ የብለይን። ኣነ ኽሳዕ ዝመጽእ ድማ ካልእ ቀዲሙኒ ይወርድ፡ ኢሉ መለሰሉ።"},{"verse":{"start":"8","end":"8","index":7},"text":"የሱስ ከኣ፥ ተንስእ፡ ዓራትካ ኣልዕል እሞ ኪድ፡ በሎ።"},{"verse":{"start":"9","end":"9","index":8},"text":"እቲ ሰብኣይ ብኡብኡ ሐወየ፡ ዓራቱ ኣልዒሉውን ከደ። እታ መዓልቲ እቲኣ ሰንበት ነበረት።"},{"verse":{"start":"10","end":"10","index":9},"text":"ስለዚ ኣይሁድ ነቲ ዝሐወየ ሰብኣይ፥ ሎሚ ሰንበት እያ እሞ፡ ዓራትካ ኽትጸውር ኣይተፈቕደልካን፡ በልዎ።"},{"verse":{"start":"11","end":"11","index":10},"text":"ንሱ ግና፥ እቲ ዘሕወየኒ እዩ ዓራትካ ኣልዕል እሞ ኪድ ዝበለኒ፡ ኢሉ መለሰሎም።"},{"verse":{"start":"12","end":"12","index":11},"text":"ንሳቶም፥ እቲ ዓራትካ ኣልዕል እሞ ኪድ ዝበለካ ሰብኣይከ እንታዋይ እዩ፧ ኢሎም ሐተትዎ።"},{"verse":{"start":"13","end":"13","index":12},"text":"እቲ ዝሐወየ ግና፡ ኣብቲ ቦታ እቲ ብዙሕ ህዝቢ ስለ ዝነበረ እሞ የሱስ ድሕር ኢሉ ስለ ዝነበረ፡ ንሱ መን ምዃኑ ኣይፈለጠን።"},{"verse":{"start":"14","end":"14","index":13},"text":"ድሕርዚ የሱስ ኣብ ቤተ መቕደስ ረኸቦ እሞ፥ እንሆ ሐዊኻ፡ ካብዚ ዚገድድ ከይረኽበካስ፡ መሊስካ ኣይትበድል፡ በሎ።"},{"verse":{"start":"15","end":"15","index":14},"text":"እቲ ሰብኣይ ከይዱ፡ ንኣይሁድ እቲ ዘሕወዮስ የሱስ ምዃኑ ነገሮም።"},{"verse":{"start":"16","end":"16","index":15},"text":"ስለዚ፡ ብሰንበት እዚ ስለ ዝገበረ፡ ኣይሁድ ንየሱስ ይሰጕዎ፡ ኪቐትልዎውን ይደልዩ ነበሩ።"},{"verse":{"start":"17","end":"17","index":16},"text":"የሱስ ግና፥ ኣቦይ ክሳዕ ሕጂ ይገብር፡ ኣነውን እገብር አሎኹ፡ ኢሉ መለሰሎም።"},{"verse":{"start":"18","end":"18","index":17},"text":"ስለዚ ሰንበት ብምስዓሩ ጥራይ ዘይኰነስ፡ ንኣምላኽ ድማ ኣቦይ ብምባሉን ርእሱ ምስ ኣምላኽ ብምምዕርራዩን ኪቐትልዎ ኣዝዮም ይደልዩ ነበሩ።"},{"verse":{"start":"19","end":"19","index":18},"text":"የሱስ መሊሱ በሎም፥ ብሓቂ፡ ብሓቂ እብለኩም አሎኹ፡ ወድስ ኣቦኡ ኺገብሮ ዝረኣዮ እምበር፡ ካብ ርእሱ ሓንቲ ነገር እኳ ኺገብር ኣይከአሎን። ነቲ ንሱ ዚገብሮ ግብሪ እቲ ወዲ ድማ ከምኡ ዝበለ ይገብር እዩ።"},{"verse":{"start":"20","end":"20","index":19},"text":"ኣቦ ንወዲ የፍቅሮ እዩ እሞ፡ ንሱ ዚገብሮ ዘበለ ዅሉ ድማ የርእዮ። ንስካትኩም ምእንቲ ኽትግረሙ፡ ካብዚ ዝዓቢ ግብሪውን ከርእዮ እዩ።"},{"verse":{"start":"21","end":"21","index":20},"text":"ኣቦ ንምዉታት ከም ዜተንስኦም ህያዋንውን ከም ዚገብሮም፡ ወዲ ድማ ከምኡ ነቶም ዝደለዮም ህያዋን ይገብሮም እዩ።"},{"verse":{"start":"22","end":"23","index":21},"text":"ኵሉ ሰብ ከምቲ ነቦ ዜኽብሮ ገይሩ ንወዲ ምእንቲ ኬኽብሮስ፡ ፍርዲ ዘበለ ንወዲ ሃቦ እምበር፡ ኣቦ ንሓደ እኳ ኣይፈርድን እዩ። እቲ ንወዲ ዘየኽብሮ ነቲ ዝለኣኾ ኣቦውን ኣየኽብሮን እዩ።"},{"verse":{"start":"24","end":"24","index":22},"text":"እቲ ንቓለይ ዚሰምዖን በቲ ዝለኣኸኒ ዚኣምንን ናይ ዘለኣለም ህይወት ኣላቶ። ንሱ ኻብ ሞት ናብ ህይወት ተሳገረ እምበር፡ ናብ ፍርዲ ኸም ዘይበጽሕ፡ ብሓቂ፡ ብሓቂ እብለኩም አሎኹ።"},{"verse":{"start":"25","end":"25","index":23},"text":"እቶም ምዉታት ድምጺ ወዲ ኣምላኽ ዚሰምዑላ ሰዓት ትመጽእ፡ ንሳ ኸኣ ሕጂ እያ፡ እቶም ዚሰምዕዎ ድማ ህያዋን ኪዀኑ እዮም፡ ኢለ ብሓቂ፡ ብሓቂ እብለኩም አሎኹ።"},{"verse":{"start":"26","end":"26","index":24},"text":"ነቦ ብርእሱ ህይወት ከም ዘላቶ፡ ንወዱውን ከምኡ ብርእሱ ኽትህልዎ፡ ህይወት ሃቦ።"},{"verse":{"start":"27","end":"27","index":25},"text":"ወዲ ሰብ እዩ እሞ፡ ኪፈርድ ስልጣን ሃቦ።"},{"verse":{"start":"28","end":"29","index":26},"text":"ኣብ መቓብር ዘለዉ ዅላቶም ድምጺ ዚሰምዑላ ሰዓት ክትመጽእ እያ፡ ሰናይ ዝገበረ ናብ ትንሳኤ ህይወት፡ እኩይ ዝገበሩ ኸኣ ናብ ትንሳኤ ፍርዲ ኺወጹ እዮም እሞ፡ በዚ ኣይትደነቑ።"},{"verse":{"start":"30","end":"30","index":27},"text":"ካብ ርእሰይ ገለ ኽገብር ኣይክእልን። ፍቓድ እቲ ዝለኣኸኒ እምበር፡ ፍቓደይ ኣይደልን እየ እሞ፡ ኣነ ከምቲ ዝሰማዕክዎ እየ ዝፈርድ፡ ፍርደይ ከኣ ቅኑዕ እዩ።"},{"verse":{"start":"31","end":"31","index":28},"text":"ኣነ ብዛዕባ ርእሰይ ባዕለይ እንተ መስከርኩ፡ ምስክረይ ሓቂ ኣይከውንን እዩ።"},{"verse":{"start":"32","end":"32","index":29},"text":"ንኣይ ዚምስክረለይሲ ኻልእ አሎ፡ እቲ ንሱ ብዛዕባይ ዚምስክሮ ምስክር ከኣ ሓቂ ምኳኑ እፈልጥ አሎኹ።"},{"verse":{"start":"33","end":"33","index":30},"text":"ንስኻትኩም ናብ ዮሃንስ ለኣኽኩም፡ ንሱ ኸኣ ንሓቂ መስከረ።"},{"verse":{"start":"34","end":"34","index":31},"text":"እዚ ግና ንስኻትኩም ምእንቲ ኽትድሕኑ እብል አሎኹ እምበር፡ ኣነስ ምስክር ሰብ ዝቕበል ኣይኰንኩን።"},{"verse":{"start":"35","end":"35","index":32},"text":"ንሱ ዚነድድን ዜብርህን መብራህቲ ነበረ። ንስኻትኩም ከኣ በቲ ብርሃኑ ቕሩብ ጊዜ ባህ ኪብለኩም ደሌኹም።"},{"verse":{"start":"36","end":"36","index":33},"text":"ግናኸ እቲ ኣቦይ ክፍጽሞ ኢሉ ዝሃበኒ ግብሪ፡ እዚ ኣነ ዝገብሮ ዘሎኹ ግብሪ፡ ንሱ ኣቦይ ከም ዝለኣኸኒ ብዛዕባይ ይምስክር እዩ እሞ፡ ኣነ ኻብ ምስክር ዮሃንስ ዚዓቢ ምስክር አሎኒ።"},{"verse":{"start":"37","end":"37","index":34},"text":"እቲ ዝለኣኸኒ ኣቦይ ከኣ፡ ንሱ ባዕሉ ብዛዕባይ መስከረ። ድምጹ ከቶ ኣይሰማዕኩምን ምስሉውን ኣይርኤኹምን።"},{"verse":{"start":"38","end":"38","index":35},"text":"በቲ ንሱ ዝለኣኾ ኣይኣመንኩምን እሞ፡ ቃሉውን ኣይሐደረኩምን።"},{"verse":{"start":"39","end":"39","index":36},"text":"ናይ ዘለኣለም ህይወት በተን ጹሑፋት እትረኽቡ እናመሰለኩምሲ ትምርምርወን አሎኹም፡ ንሳተን ከኣ ብዛዕባይ እየን ዚምስክራ።"},{"verse":{"start":"40","end":"40","index":37},"text":"ህይወት ምእንቲ ኽትረኽቡ፡ ናባይ ክትመጹ ኣይትደልዩን ኢኹም።"},{"verse":{"start":"41","end":"41","index":38},"text":"ኣነ ውዳሴ ሰብ ኣይቅበልን እየ።"},{"verse":{"start":"42","end":"42","index":39},"text":"ፍቕሪ ኣምላኽ ከም ዜብልኩም ግና እፈልጠኩም አሎኹ።"},{"verse":{"start":"43","end":"43","index":40},"text":"ኣነ ብስም ኣቦይ መጻእኩ እሞ ኣይተቐበልኩምንን፡ ካልእ ብስም ርእሱ እንተ መጸ፡ ንእኡ ኽትቅበልዎ ኢኹም።"},{"verse":{"start":"44","end":"44","index":41},"text":"ንስኻትኩም ካብ ሓድሕድኩም ክብረት እትቃባበሉ፡ ነታ ካብ ሓደ ኣምላኽ እትርከብ ክብረት ዘይትደልዩ፡ ከመይ ኢልኩም ክትኣምኑ ይዀነልኩም፡"},{"verse":{"start":"45","end":"45","index":42},"text":"ኣነ ኣብ ኣቦ ዝኸሰኩም ኣይምሰልኩም። ዚኸስኩምሲ አሎ፡ ንሱ ኸኣ እቲ ንስኻትኩም ተስፋ እትገብርዎ ሙሴ እዩ።"},{"verse":{"start":"46","end":"46","index":43},"text":"ንሙሴ እንተ ትኣምንዎስ፡ ንሱ ብዛዕባይ ጽሒፉ አሎ እሞ፡ ንኣይ ድማ ምኣመንኩምኒ ኔርኩም።"},{"verse":{"start":"47","end":"47","index":44},"text":"ነተን ጽሑፋቱ ኻብ ዘይትኣምንወን ግና፡ ከመይ ኢልኩም ደኣ ንቓለይ ክትኣምንዎ፡"}],[{"verse":{"start":"1","end":"1","index":0},"text":"ድሕርዚ የሱስ ናብ ማዕዶ ባሕሪ ገሊላ፡ ንሳ ኸኣ ባሕሪ ጥብርያዶስ፡ ከደ።"},{"verse":{"start":"2","end":"2","index":1},"text":"ብዙሓት ህዝቢ ኸኣ፡ ኣብ ሕሙማት ዝገበሮ ተኣምራት ርእዮም ነበሩ እሞ፡ ሰዓብዎ።"},{"verse":{"start":"3","end":"3","index":2},"text":"የሱስ ድማ ናብ ከረን ደዪቡ፡ ኣብኡ ምስ ደቀ መዛሙርቱ ተቐመጠ።"},{"verse":{"start":"4","end":"4","index":3},"text":"ፋስጋ፡ እቲ በዓል ኣይሁድ፡ ድማ ቀሪቡ ነበረ።"},{"verse":{"start":"5","end":"5","index":4},"text":"ሽዑ የሱስ ኣዒንቱ ቛሕ ኣቢሉ፡ ብዙሕ ህዝቢ ናብኡ ኺመጽእ ከሎ ርእዩ፡ ንፊልጶስ፥ እዚኣቶም ምእንቲ ኺበልዑስ እንጌራ ኻበይ ክንዕድግ ኢና፧ በሎ።"},{"verse":{"start":"6","end":"6","index":5},"text":"እቲ ኺገብሮ ዝደለዮስ ባዕሉ ፈሊጥዎ ነበረ እሞ፡ እዚ ዝበሎ ምእንቲ ኺዕዘቦ እዩ።"},{"verse":{"start":"7","end":"7","index":6},"text":"ፊልጶስ ከኣ፡ ናይ ክልተ ሚእቲ ዲናር እንጌራ እኳ ቘቍራስ ኣይበጽሖምን እዩ፡ ኢሉ መለሰሉ።"},{"verse":{"start":"8","end":"8","index":7},"text":"ካብቶም ደቀ መዛሙርቱስ ሓደ፡ ንሱ ኸኣ እንድርያስ ሓው ስምኦን ጴጥሮስ፥"},{"verse":{"start":"9","end":"9","index":8},"text":"ሓሙሽተ ጐጎ ስገምን ክልተ ዓሳን ዘለዎ ቘልዓ ኣብዚ አሎ። እዚኣተን ግና ንኽንድዚ ዚኣክል ሰብ እንታይ ይጠቕማ፧ በሎ።"},{"verse":{"start":"10","end":"10","index":9},"text":"የሱስ ከኣ፥ ኣቐምጥዎም፡ በለ። ኣብታ ቦታ እቲኣ ኸኣ ብዙሕ ሳዕሪ ነበረ። ሽዑ ተቐመጡ፡ ቍጽሮም ከኣ ኣስታት ሓሙሽተ ሽሕ ሰብኣይ ዚኣኽሉ ነበሩ።"},{"verse":{"start":"11","end":"11","index":10},"text":"የሱስ ነተን ጐጎታት ኣልዒሉ፡ ኣመስጊኑ ነቶም እተቐመጡ ሃቦም፡ ካብቲ ዓሳታት ከኣ ከምኡ ከከም ዝደለይዎ መቐሎም።"},{"verse":{"start":"12","end":"12","index":11},"text":"ምስ ጸገቡ ድማ፡ ንደቀ መዛሙርቱ፡ ዝተረፈ ቘረርስ፡ ሓንቲ እኳ ኸይትጠፍእ፡ ኣክብዎ፡ በሎም።"},{"verse":{"start":"13","end":"13","index":12},"text":"ስለዚ ኣከብዎ፡ ተረፍ እቶም ዝበልዑ ካብተን ሓሙሽተ ጐጎ ስገም ዓሰርተው ክልተ መሶብ ቈረርስ መልኡ።"},{"verse":{"start":"14","end":"14","index":13},"text":"እቶም ሰብ ከኣ ነቲ የሱስ ዝገበሮ ትእምርቲ ምስ ረኣዩ፥ እዚ ብሓቂ እቲ ናብ ዓለም ኪመጽእ ዘለዎ ነብዪ እዩ፡ በሉ።"},{"verse":{"start":"15","end":"15","index":14},"text":"የሱስ ድማ፡ መጺኦም መንዚዖም ኬንግስዎ ኸም ዝደለዩ ፈሊጡ፡ ከም ብሓድሽ በይኑ ናብ ከረን ኣግለሰ።"},{"verse":{"start":"16","end":"16","index":15},"text":"ምስ መሰየ፡ ደቀ መዛሙርቱ ናብ ባሕሪ ወረዱ።"},{"verse":{"start":"17","end":"17","index":16},"text":"ኣብ ጃልባ ኣትዮም ከኣ ናብ ስግር ባሕሪ ናብ ቅፍርናሆም ከዱ። ጸልሚቱ ነበረ፡ የሱስውን ናባታቶም ገና ኣይመጸን ነበረ።"},{"verse":{"start":"18","end":"18","index":17},"text":"እቲ ባሕሪ ግና፡ ብርቱዕ ህቦብላ ስለ ዝነፈሰ፡ ይናወጽ ነበረ።"},{"verse":{"start":"19","end":"19","index":18},"text":"ዕስራን ሓሙሽተን ወይ ሰላሳ እስታድዮስ ምስ ከዱ ኸኣ፡ የሱስ ባሕሪ ባሕሪ እናኸደ ናብታ ጃልባ ኪቐርብ ከሎ፡ ርእዮም ፈርሁ።"},{"verse":{"start":"20","end":"20","index":19},"text":"ንሱ ግና፡ ኣነ እየ፡ ኣይትፍርሁ፡ በሎም።"},{"verse":{"start":"21","end":"21","index":20},"text":"ሽዑ ናብ ጃልባ ኼእትውዎ ደለዩ፡ እታ ጃልባ ኸኣ ብኡብኡ ናብቲ ዚኸድዎ ዘለዉ ምድሪ በጽሔት።"},{"verse":{"start":"22","end":"22","index":21},"text":"ንጽብሒቱ እቶም ኣብ ስግር ባሕሪ ደው ኢሎም ዘለዉ ህዝቢ፡ ብጀካ ሓንቲ ጃልባ ኽልእ ኣብኡ ኸም ዘይነበረት፡ ደቀ መዛሙርቱ ጥራይ ንበይኖም ከም ዝኸዱ እምበር፡ የሱስ ናብታ ጃልባ ኸም ዘይኣተወ ምስ ረኣዩ፦"},{"verse":{"start":"23","end":"23","index":22},"text":"ግናኸ ኻልኦት ጀላቡ ካብ ጥብርያዶስ ናብ ጥቓ እታ ጐይታ ምስ ባረኸ እንጌራ ዝበልዑላ ቦታ መጻ፦"},{"verse":{"start":"24","end":"24","index":23},"text":"ሽዑ እቶም ዝህቢ፡ የሱስ ኰነ ወይ ደቀ መዛሙርቱ ኣብኡ ዘይምህላዎም ርእዮም፡ ንሳቶም ድማ ናብተን ጃለቡ ኣትዮም ንየሱስ እናደለይዎ ናብ ቅፍርናሆም መጹ።"},{"verse":{"start":"25","end":"25","index":24},"text":"ኣብ ስግር ባሕሪ ምስ ረኸብዎ ኸኣ፥ ረቢ፡ መኣዝ ናብዚ መጻእካ፡ በልዎ።"},{"verse":{"start":"26","end":"26","index":25},"text":"የሱስ ድማ፥ እትደልዩኒ ዘሎኹምሲ እንጌራ ስለ ዝበላዕኩምን ዝጸገብኩምን ኢኹም እምበር፡ ተኣምራት ስለ ዝርኤኹም ከም ዘይኰንኩም፡ ብሓቂ ብሓቂ እብለኩም አሎኹ።"},{"verse":{"start":"27","end":"27","index":26},"text":"ወዲ ሰብ፡ ንእኡ ኣቦ፡ ንሱ ኸኣ ኣምላኽ፡ ሐቲምዎ እዩ እሞ፡ ነቲ ንሱ ዚህበኩም ንዘለኣለም ህይወት ዚነብር ብልዒ እምበር፡ ነዚ ሓላፊ ብልዒ ኣይትግበሩ’ ኢሉ መለሰሎም።"},{"verse":{"start":"28","end":"28","index":27},"text":"ስለዚ ንሳቶም፥ ግብሪ ኣምላክ ክንገብርሲ እንታይ ንግበር፡ በልዎ።"},{"verse":{"start":"29","end":"29","index":28},"text":"የሱስ ከኣ፡ ግብሪ ኣምላኽ በቲ ንሱ ዝለኣኾ ኽትኣምኑ እዩ፡ በሎም።"},{"verse":{"start":"30","end":"30","index":29},"text":"ስለዚ፥ ርኢና ክንኣምነካስ እንታይ ትእምርቲ እሞ ትገብር