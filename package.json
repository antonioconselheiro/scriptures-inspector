{
  "name": "scriptures-inspector",
  "version": "0.0.0",
  "scripts": {
    "dev:web": "CI=TRUE ng serve --host 0.0.0.0",
    "build:web": "rm -rf dist; CI=TRUE ng build; mv dist/browser/** dist; rm -rf dist/browser",
    "build:lnx": "electron-forge make --targets=@electron-forge/maker-deb --icon=public/script.png",
    "test": "CI=TRUE ng test --watch=false --browsers=ChromeHeadlessNoSandbox"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/common": "^20.3.16",
    "@angular/compiler": "^20.3.16",
    "@angular/core": "^20.3.16",
    "@angular/forms": "^20.3.16",
    "@angular/platform-browser": "^20.3.16",
    "@angular/router": "^20.3.16",
    "@belomonte/async-modal-ngx": "^20.0.0",
    "@belomonte/iterable-string": "^1.0.2",
    "hebrew-transliteration": "^2.9.1",
    "jsdom": "^27.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.14",
    "@angular/cli": "^20.3.14",
    "@angular/compiler-cli": "^20.3.16",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
